{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "types": ["node"],
    "lib": ["es2018", "dom"],
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./lib",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/__tests__/*"]
}
